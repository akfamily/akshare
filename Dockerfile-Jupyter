# AKShare 与 JupyterLab 的数据分析镜像（文档中的 aktools:jupyter）
# 构建：docker build -f Dockerfile-Jupyter -t aktools:jupyter .
# 运行：docker run -it -p 8888:8888 -v /本地目录:/home aktools:jupyter，然后打开终端输出的地址
# 国内构建可指定镜像源：docker build --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ -f Dockerfile-Jupyter -t aktools:jupyter .
FROM python:3.14-slim-trixie

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Shanghai

RUN pip install --index-url "$PIP_INDEX_URL" --upgrade akshare aktools jupyterlab scikit-learn scipy

# 工作目录与文档中挂载的 /home 一致，Notebook 直接保存到宿主机目录
WORKDIR /home

EXPOSE 8888

# 以 root 运行，便于读写挂载进来的宿主机目录
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
